# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_actual_mysql_password
DB_NAME=bizora
# Set DB_SSL=true for cloud hosting providers (e.g. Aiven, TiDB Cloud)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT Authentication Secrets
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Client & API URLs (Support multiple comma-separated client URLs)
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Payment Gateway (Razorpay)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_MODE=test
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Email Configuration (Optional - for password reset & email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=Bizora Digital Market <your_email@domain.com>
